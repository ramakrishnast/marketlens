# ---- MarketLens configuration. Copy to .env (make run does this) and fill in what you have. ----
# Everything works without keys except the AI features (and keyed news sources).

# AI (OpenAI only, model gpt-6-luna). Without it, AI panels show "add an API key".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# SEC EDGAR requires a User-Agent with your name + contact email, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=

# Macro data: free key from https://fred.stlouisfed.org/docs/api/api_key.html
# (without it, series still load via FRED's public CSV; the release calendar needs the key)
FRED_API_KEY=

# News (free tiers): https://finnhub.io/register  and/or  https://www.alphavantage.co/support/#api-key
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Reddit crowd posts (optional): create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MarketLens/1.0 (personal research)

# Data mode: auto = live with fallback to bundled sample data | live = live only | mock = sample data only
DATA_MODE=auto
PRICE_TTL_MINUTES=15
# Sentiment: auto (FinBERT if installed via `make finbert`, else lexicon) | finbert | lexicon
SENTIMENT_MODEL=auto

# Daily briefing (weekdays) and optional email delivery
TIMEZONE=America/New_York
BRIEFING_TIME=07:30
SCHEDULER_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BRIEFING_EMAIL_TO=

# Backtest: allow user-written Python strategy classes (runs your code locally in the container)
ALLOW_CUSTOM_STRATEGIES=true
# ---- Database (PostgreSQL, started by docker compose) ----
# `make run` generates a random POSTGRES_PASSWORD here on first run. It is only read when the database volume is
# first created: changing it later requires `make destroy-db` (deletes data!) or ALTER USER inside the database.
POSTGRES_USER=marketlens
POSTGRES_PASSWORD=marketlens
POSTGRES_DB=marketlens
# Host port for connecting with psql/BI tools (127.0.0.1 only)
POSTGRES_PORT=5433
# Optional: use a different Postgres instead of the bundled one, e.g. postgresql://user:pass@host:5432/marketlens
DATABASE_URL=

# ---- Deployment ----
# Host port for the web UI (container always listens on 8000 internally)
PORT=8000
# 127.0.0.1 = only this machine (default, safest) | 0.0.0.0 = reachable from your LAN/server IP
HOST_BIND=127.0.0.1
